@page "/judging"
@using ContestJudging.Core.Entities

<PageTitle>EOH 2026 - Judging</PageTitle>

<div class="judging-container container mt-4 mb-5" @onkeydown="HandleKeyDown" tabindex="0">
    <h3 class="display-5 mb-4" style="font-family: var(--eoh-font-headings); font-weight: 300; letter-spacing: -0.05rem;">Judging</h3>

    <div class="row mb-4">
        <div class="col-md-5">
            <label class="form-label fw-semibold text-uppercase small" style="color: var(--eoh-blue); letter-spacing: 0.05rem;">1. Select Category</label>
            <select class="form-select" style="border-color: var(--eoh-border) !important; border-radius: var(--eoh-radius); padding: 0.65rem 1rem;" @onchange="OnCategoryChanged">
                <option value="">-- Choose Category --</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id">@cat.Id</option>
                }
            </select>
        </div>
    </div>

    @if (selectedCategory != null)
    {
        <div class="card p-4 mb-5 border-0 shadow-sm border-start border-4" style="border-left-color: var(--eoh-blue) !important;">
            <h4 class="mb-2" style="font-family: var(--eoh-font-headings); font-weight: 600; color: var(--eoh-blue);"><i class="bi bi-filter-circle-fill me-2"></i>Partition Focus</h4>
            <p class="mb-4" style="color: var(--eoh-charcoal); opacity: 0.65; font-size: 0.95rem;">Filter entries by judging group to focus your comparisons. Bridge nodes will automatically appear in multiple groups.</p>
            
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold" style="color: var(--eoh-blue); font-size: 0.9rem;">Total Groups (k)</label>
                    <input type="number" class="form-control" @bind="kPartitions" min="1" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold" style="color: var(--eoh-blue); font-size: 0.9rem;">Overlap Rate (o)</label>
                    <input type="number" class="form-control" @bind="overlapRate" step="0.01" min="0" max="1" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-primary w-100" @onclick="GeneratePartitions">Activate Partitions</button>
                </div>
                @if (currentPartitions != null)
                {
                    <div class="col-md-3">
                        <label class="form-label fw-semibold" style="color: var(--eoh-blue); font-size: 0.9rem;">Active Group</label>
                        <select class="form-select bg-light fw-bold" value="@selectedPartitionId" @onchange="OnPartitionChanged">
                            @foreach (var pId in currentPartitions.Keys)
                            {
                                <option value="@pId">Group @pId</option>
                            }
                        </select>
                    </div>
                }
            </div>
        </div>

        @if (suggestedPair != null)
        {
            <div class="quick-judge-container mb-5 shadow-sm rounded-4 p-5 border" style="background: var(--eoh-warm-neutral); border-color: var(--eoh-border); border-radius: 16px !important;">
                <div class="text-center mb-5">
                    <h5 class="fw-bold text-uppercase" style="opacity: 0.65; font-family: var(--eoh-font-headings); font-size: 0.8rem; letter-spacing: 0.1rem; color: var(--eoh-altgeld-orange) !important;">
                        <i class="bi bi-lightning-charge-fill me-1" style="color: var(--eoh-orange);"></i>Quick-Judge Mode
                    </h5>
                    <p class="small d-none d-md-block" style="color: var(--eoh-charcoal); opacity: 0.65; font-family: var(--eoh-font-serif); font-style: italic; font-size: 0.95rem; margin-top: 0.5rem;">
                        Use keyboard: <span class="badge px-2 py-1 mx-1 border" style="background: rgba(12, 24, 43, 0.15); color: var(--eoh-warm-neutral); border-color: var(--eoh-border);">A</span> (Left Wins), <span class="badge px-2 py-1 mx-1 border" style="background: rgba(12, 24, 43, 0.15); color: var(--eoh-warm-neutral); border-color: var(--eoh-border);">S</span> (Equal), <span class="badge px-2 py-1 mx-1 border" style="background: rgba(12, 24, 43, 0.15); color: var(--eoh-warm-neutral); border-color: var(--eoh-border);">D</span> (Right Wins)
                    </p>
                </div>

                <div class="row g-4 align-items-stretch">
                    <div class="col-5 col-md-5">
                        <div class="judge-card h-100 text-center p-5 rounded shadow-sm"
                             role="button" tabindex="0" aria-label="Vote @suggestedPair.Value.A better than @suggestedPair.Value.B"
                             @onclick="() => RecordResult(Operator.GreaterThan)"
                             @onkeydown="(KeyboardEventArgs e) => HandleCardKeyDown(e, Operator.GreaterThan)">
                            <div class="badge mb-3 py-2 px-3" style="background-color: var(--eoh-blue); letter-spacing: 0.05rem; font-family: var(--eoh-font-headings);">EXHIBIT A</div>
                            <h2 class="display-6 fw-bold mb-0 text-primary">@suggestedPair.Value.A</h2>
                            <div class="mt-4 d-md-none"><span class="btn btn-primary w-100">Better</span></div>
                        </div>
                    </div>

                    <div class="col-2 col-md-2 d-flex flex-column justify-content-center align-items-center">
                        <div class="tie-button p-4 rounded-circle border text-center shadow-sm d-flex flex-column justify-content-center align-items-center"
                              role="button" tabindex="0" aria-label="Mark @suggestedPair.Value.A and @suggestedPair.Value.B as equal"
                              @onclick="() => RecordResult(Operator.EqualTo)"
                              @onkeydown="(KeyboardEventArgs e) => HandleCardKeyDown(e, Operator.EqualTo)"
                              title="They are equal in quality"
                              style="width: 80px; height: 80px; border-color: var(--eoh-border) !important; background: var(--eoh-warm-neutral);">
                            <i class="bi bi-repeat fs-3" style="color: var(--eoh-charcoal); opacity: 0.65;"></i>
                            <div class="smaller fw-bold mt-1" style="color: var(--eoh-charcoal); opacity: 0.65; font-size: 0.65rem; letter-spacing: 0.05rem;">TIE</div>
                        </div>
                    </div>

                    <div class="col-5 col-md-5">
                        <div class="judge-card h-100 text-center p-5 rounded shadow-sm"
                             role="button" tabindex="0" aria-label="Vote @suggestedPair.Value.B better than @suggestedPair.Value.A"
                             @onclick="() => RecordResult(Operator.LessThan)"
                             @onkeydown="(KeyboardEventArgs e) => HandleCardKeyDown(e, Operator.LessThan)">
                            <div class="badge mb-3 py-2 px-3" style="background-color: var(--eoh-blue); letter-spacing: 0.05rem; font-family: var(--eoh-font-headings);">EXHIBIT B</div>
                            <h2 class="display-6 fw-bold mb-0 text-primary">@suggestedPair.Value.B</h2>
                            <div class="mt-4 d-md-none"><span class="btn btn-primary w-100">Better</span></div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="mb-4">
            <div class="card border-0 shadow-sm" style="overflow: hidden;">
                <div class="card-header border-0 py-3" style="background: var(--eoh-warm-neutral);">
                    <button class="accordion-button @(showManualOverride ? "" : "collapsed") fw-bold text-uppercase shadow-none w-100 btn text-start border-0 p-0 d-flex justify-content-between align-items-center"
                            type="button"
                            @onclick="() => showManualOverride = !showManualOverride"
                            style="background: var(--eoh-warm-neutral); color: var(--eoh-blue); font-family: var(--eoh-font-headings); font-size: 0.9rem; letter-spacing: 0.05rem;">
                        <span><i class="bi bi-pencil-square me-2" style="color: var(--eoh-altgeld-orange);"></i> Manual Override / Correction</span>
                    </button>
                </div>
                @if (showManualOverride)
                {
                    <div class="card-body border-top" style="border-top-color: var(--eoh-border) !important;">
                        <div class="row align-items-end g-3">
                            <div class="col-md-4">
                                <label class="form-label fw-semibold" style="color: var(--eoh-blue);">Exhibit A</label>
                                <select class="form-select" @bind="entryAId">
                                    <option value="">-- Choose Exhibit --</option>
                                    @foreach (var entry in GetFilteredEntries())
                                    {
                                        <option value="@entry.Id">@entry.Id</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2 text-center">
                                <label class="form-label fw-semibold" style="color: var(--eoh-blue);">Relation</label>
                                <select class="form-select fw-bold text-center" @bind="op">
                                    <option value="@Operator.GreaterThan">&gt; Better</option>
                                    <option value="@Operator.EqualTo">= Equal</option>
                                    <option value="@Operator.LessThan">&lt; Worse</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold" style="color: var(--eoh-blue);">Exhibit B</label>
                                <select class="form-select" @bind="entryBId">
                                    <option value="">-- Choose Exhibit --</option>
                                    @foreach (var entry in GetFilteredEntries())
                                    {
                                        <option value="@entry.Id">@entry.Id</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button class="btn btn-primary w-100 shadow-sm" style="background-color: var(--eoh-altgeld-orange); border-color: var(--eoh-altgeld-orange);" @onclick="AddRelation">
                                    <i class="bi bi-check-lg"></i> Submit
                                </button>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="text-danger mt-2 fw-bold" style="font-size: 0.9rem;"><i class="bi bi-x-circle-fill me-1"></i>@errorMessage</div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm mt-5" style="overflow: hidden;">
            <div class="card-header text-white py-3" style="background-color: var(--eoh-blue); border-bottom: 2px solid var(--eoh-orange);">
                <h5 class="mb-0" style="font-family: var(--eoh-font-headings); font-weight: 600; text-transform: none;"><i class="bi bi-list-check me-2"></i>Recorded Relations (@relations.Count)</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background: var(--eoh-light-gray);">
                            <tr style="background-color: var(--eoh-warm-neutral);">
                                <th class="ps-4 py-3" style="font-family: var(--eoh-font-headings); font-size: 0.85rem; letter-spacing: 0.03rem; text-transform: uppercase; color: var(--eoh-blue);">Exhibit A</th>
                                <th class="text-center py-3" style="font-family: var(--eoh-font-headings); font-size: 0.85rem; letter-spacing: 0.03rem; text-transform: uppercase; color: var(--eoh-blue);">Relationship</th>
                                <th class="py-3" style="font-family: var(--eoh-font-headings); font-size: 0.85rem; letter-spacing: 0.03rem; text-transform: uppercase; color: var(--eoh-blue);">Exhibit B</th>
                                <th class="pe-4 text-end py-3" style="font-family: var(--eoh-font-headings); font-size: 0.85rem; letter-spacing: 0.03rem; text-transform: uppercase; color: var(--eoh-blue);">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize Items="@relations" Context="rel">
                                <tr @key="@(rel.EntryA.Id + '|' + rel.EntryB.Id)" class="border-bottom" style="border-color: var(--eoh-border);">
                                    <td class="ps-4 fw-semibold text-primary py-3" style="font-size: 1.05rem; color: var(--eoh-blue) !important;">@rel.EntryA.Id</td>
                                    <td class="text-center py-3">
                                        <span class="badge py-2 px-3 rounded-pill" style="font-weight: 600; font-size: 0.8rem; background: @(rel.Operator == Operator.EqualTo ? "var(--eoh-light-gray)" : "rgba(var(--eoh-blue-rgb), 0.12)"); color: @(rel.Operator == Operator.EqualTo ? "var(--eoh-charcoal)" : "var(--eoh-blue)");">
                                            @GetOpText(rel.Operator)
                                        </span>
                                    </td>
                                    <td class="fw-semibold text-primary py-3" style="font-size: 1.05rem; color: var(--eoh-blue) !important;">@rel.EntryB.Id</td>
                                    <td class="pe-4 text-end py-3">
                                        <button class="btn btn-outline-danger btn-sm px-3" style="border-radius: 20px;" @onclick="() => DeleteRelation(rel)">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </td>
                                </tr>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .judging-container:focus {
        outline: none;
    }

    .judge-card {
        cursor: pointer;
        transition: var(--eoh-transition);
        background-color: var(--eoh-warm-neutral);
        border: 1px solid var(--eoh-border) !important;
        border-radius: 12px !important;
    }

    .judge-card:hover {
        background-color: var(--eoh-warm-neutral);
        transform: translateY(-4px);
        border-color: var(--eoh-altgeld-orange) !important;
        box-shadow: 0 12px 24px rgba(var(--eoh-charcoal-rgb), 0.08) !important;
    }

    .judge-card:active {
        transform: translateY(0px);
    }

    .tie-button {
        cursor: pointer;
        transition: var(--eoh-transition);
    }

    .tie-button:hover {
        background-color: var(--eoh-warm-neutral) !important;
        transform: scale(1.1);
        border-color: var(--eoh-altgeld-orange) !important;
        box-shadow: 0 4px 10px rgba(var(--eoh-charcoal-rgb), 0.08) !important;
    }

    .tie-button:active {
        transform: scale(0.95);
    }

    @@media (max-width: 768px) {
        .quick-judge-container {
            padding: 2rem !important;
        }
        .judge-card {
            padding: 2rem !important;
        }
    }

    @@media (max-width: 576px) {
        .quick-judge-container {
            padding: 1.25rem 0.75rem !important;
        }
        .judge-card {
            padding: 1.5rem 0.5rem !important;
        }
        .judge-card h2 {
            font-size: 1.15rem !important;
        }
        .judge-card .badge {
            font-size: 0.65rem !important;
            padding: 0.2rem 0.4rem !important;
        }
        .tie-button {
            width: 60px !important;
            height: 60px !important;
            padding: 0.5rem !important;
        }
        .tie-button i {
            font-size: 1.25rem !important;
        }
        .tie-button div {
            font-size: 0.5rem !important;
        }
    }
</style>
