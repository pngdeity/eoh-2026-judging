@page "/setup"
@using ContestJudging.Core.Entities

<PageTitle>EOH 2026 - Setup</PageTitle>

<div class="container mt-4 mb-5">
    <h3 class="display-5 mb-4" style="font-family: var(--eoh-font-headings); font-weight: 300; letter-spacing: -0.05rem;">Contest Setup</h3>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger border-start border-4 shadow-sm mb-4" style="border-left-color: var(--eoh-altgeld-orange) !important; border-radius: var(--eoh-radius);">
            <i class="bi bi-exclamation-circle-fill me-2"></i>@errorMessage
        </div>
    }

    <div class="row g-4">
        <div class="col-md-6">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 style="font-family: var(--eoh-font-headings); font-weight: 600; color: var(--eoh-blue); margin-bottom: 0;">Categories</h4>
                @if (categories.Any())
                {
                    <button class="btn btn-outline-danger btn-sm px-3" style="border-radius: 20px;" @onclick="ClearCategories">Clear All</button>
                }
            </div>
            <div class="card p-4 mb-4 border-0">
                <EditForm Model="@newCategory" OnValidSubmit="AddCategory">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="color: var(--eoh-blue);">Rubric Category Name</label>
                        <InputText class="form-control" placeholder="e.g. Innovation" @bind-Value="newCategory.Id" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="color: var(--eoh-blue);">Maximum Score</label>
                        <InputNumber class="form-control" @bind-Value="newCategory.MaxScore" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-2">Add Category</button>
                </EditForm>
            </div>

            <ul class="list-group list-group-flush shadow-sm rounded-3 p-2" style="background: var(--eoh-warm-neutral); max-height: 300px; overflow-y: auto;">
                <Virtualize Items="@categories" Context="cat">
                    <li @key="cat.Id" class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom" style="background: transparent; border-color: var(--eoh-border) !important;">
                        <div>
                            <span class="fw-semibold" style="color: var(--eoh-blue); font-size: 1.05rem;">@cat.Id</span>
                            <span class="ms-2 small" style="color: var(--eoh-charcoal); opacity: 0.65;">(Max: @cat.MaxScore)</span>
                        </div>
                        <button class="btn btn-outline-danger btn-sm py-1 px-3" style="border-radius: 20px;" @onclick="() => DeleteCategory(cat.Id)">Delete</button>
                    </li>
                </Virtualize>
            </ul>
        </div>

        <div class="col-md-6">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 style="font-family: var(--eoh-font-headings); font-weight: 600; color: var(--eoh-blue); margin-bottom: 0;">Entries (Teams/Projects)</h4>
                @if (entries.Any())
                {
                    <button class="btn btn-outline-danger btn-sm px-3" style="border-radius: 20px;" @onclick="ClearEntries">Clear All</button>
                }
            </div>
            <div class="card p-4 mb-4 border-0">
                <EditForm Model="@newEntry" OnValidSubmit="AddEntry">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold" style="color: var(--eoh-blue);">Entry Name (ID)</label>
                        <InputText class="form-control" placeholder="e.g. Bio-Battery" @bind-Value="newEntry.Id" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mt-2">Add Entry</button>
                </EditForm>
            </div>

            <ul class="list-group list-group-flush shadow-sm rounded-3 p-2 mb-4" style="background: var(--eoh-warm-neutral); max-height: 300px; overflow-y: auto;">
                <Virtualize Items="@entries" Context="entry">
                    <li @key="entry.Id" class="list-group-item d-flex justify-content-between align-items-center py-3 border-0 border-bottom" style="background: transparent; border-color: var(--eoh-border) !important;">
                        <span class="fw-semibold" style="color: var(--eoh-blue); font-size: 1.05rem;">@entry.Id</span>
                        <button class="btn btn-outline-danger btn-sm py-1 px-3" style="border-radius: 20px;" @onclick="() => DeleteEntry(entry.Id)">Delete</button>
                    </li>
                </Virtualize>
            </ul>

            <div class="card p-4 border-0">
                <h4 style="font-family: var(--eoh-font-headings); font-weight: 600; color: var(--eoh-blue); margin-bottom: 1rem;">Bulk Import Entries</h4>
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="color: var(--eoh-blue);">Entry Names (one per line)</label>
                    <textarea class="form-control" rows="4" @bind="bulkEntriesText" placeholder="Entry 1&#10;Entry 2&#10;Entry 3"></textarea>
                </div>
                <button class="btn btn-secondary w-100" @onclick="BulkImportEntries">Import Entries</button>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="card p-4 border-0 shadow-sm border-start border-4" style="border-left-color: var(--eoh-blue) !important;">
                <h4 class="mb-3" style="font-family: var(--eoh-font-headings); font-weight: 600; color: var(--eoh-blue);"><i class="bi bi-diagram-2-fill me-2"></i>Partition Planning</h4>
                <p class="mb-4" style="color: var(--eoh-charcoal); opacity: 0.65; font-size: 0.95rem;">Divide exhibits into groups with "bridge nodes" to ensure statistical connectivity while reducing judge workload.</p>
                
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" style="color: var(--eoh-blue);">Judging Groups (k)</label>
                        <input type="number" class="form-control" @bind="kPartitions" min="1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" style="color: var(--eoh-blue);">Overlap Rate (o)</label>
                        <input type="number" class="form-control" @bind="overlapRate" step="0.01" min="0" max="1" />
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-primary w-100" @onclick="GeneratePartitions">
                            Preview Partitions
                        </button>
                    </div>
                </div>

                @if (generatedPartitions != null)
                {
                    <div class="row mt-5 g-4">
                        @foreach (var p in generatedPartitions)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card h-100 border-0 shadow-sm">
                                    <div class="card-header fw-bold py-3" style="color: var(--eoh-blue); background-color: var(--eoh-light-gray); border-bottom: 1px solid var(--eoh-border);">Group @p.Key</div>
                                    <div class="card-body py-3">
                                        <ul class="list-unstyled mb-0">
                                            @foreach (var entryId in p.Value)
                                            {
                                                var isBridge = generatedPartitions.Values.Count(v => v.Contains(entryId)) > 1;
                                                <li class="py-2 border-bottom border-light d-flex align-items-center @(isBridge ? "fw-bold" : "")" style="font-size: 0.95rem;@(isBridge ? " color: var(--eoh-blue);" : "")">
                                                    @if (isBridge) 
                                                    { 
                                                        <i class="bi bi-link-45deg me-2" style="color: var(--eoh-orange);"></i> 
                                                    }
                                                    else
                                                    {
                                                        <span class="bullet me-2 d-inline-block rounded-circle" style="width: 5px; height: 5px; background: var(--eoh-border);"></span>
                                                    }
                                                    @entryId
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
